---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Cover from "../components/Cover.astro";
import PhotoCredit from "../components/PhotoCredit.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.path },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const style = post.data.backgroundPosition
  ? { "background-position": post.data.backgroundPosition }
  : {};
---

<Layout
  title={post.data.title}
  keywords={post.data.tags.join(" ")}
  description={post.data.title}
>
  <Cover
    title={post.data.title}
    image={post.data.cover}
    tags={post.data.tags}
    date={post.data.date}
    style={style}
  />
  <main class="container post">
    <Content />
    {post.data.photoCredit && <PhotoCredit {...post.data.photoCredit} />}
  </main>
</Layout>

<style>
  /* The blog article owns its typography. It is a long-form document with
     its own needs (a comfortable reading measure, looser rhythm, code
     blocks) so it opts out of the shared main styling in Layout.astro and
     styles itself here. The markdown from <Content /> is injected, hence
     the :global() selectors. */
  .post {
    --reading-width: 44rem;
    font-size: var(--font-500);
    line-height: 1.6;
    padding-block: var(--spacing-600);
  }

  /* One reading column shared by every top-level block, code included, so
     nothing breaks out to the full container width. */
  .post > :global(*) {
    max-width: var(--reading-width);
    margin-inline: auto;
  }

  .post :global(h2) {
    font-size: var(--font-800);
    line-height: var(--heading-line-height);
    margin-top: var(--spacing-700);
    margin-bottom: var(--spacing-300);
  }

  .post :global(h2:first-of-type) {
    margin-top: 0;
  }

  .post :global(h3) {
    font-size: var(--font-700);
    line-height: var(--heading-line-height);
    margin-top: var(--spacing-500);
    margin-bottom: var(--spacing-300);
  }

  .post :global(h4) {
    font-size: var(--font-600);
    margin-bottom: var(--spacing-200);
  }

  .post :global(h5),
  .post :global(h6) {
    font-size: var(--font-500);
    margin-top: var(--spacing-200);
    margin-bottom: var(--spacing-200);
  }

  .post :global(p),
  .post :global(ul),
  .post :global(ol) {
    font-weight: 300;
    margin-bottom: var(--spacing-400);
  }

  .post :global(a) {
    color: var(--link-blue);
    font-weight: 400;
  }

  /* max-width keeps an image inside the reading column. The column is set on
     the <p> the markdown wraps it in, which does not constrain the image
     itself, so a wide screenshot would otherwise spill past the prose. */
  .post :global(img) {
    max-width: 100%;
    height: auto;
    margin-block: var(--spacing-400);
    border-radius: var(--radius);
  }

  /* Terminal captures too wide to read at the reading measure. The doctor
     report is 113 columns, which inside 44rem leaves each character about
     6px, so these fill the container instead. Below that width they stop
     shrinking and the box scrolls, the way a wide code block does: a phone
     showing 113 columns at once shows none of them legibly. */
  .post :global(.wide) {
    max-width: none;
    width: 100%;
    overflow-x: auto;
    margin-block: var(--spacing-400);
  }

  .post :global(.wide img) {
    min-width: 900px;
    max-width: none;
    width: 100%;
    margin-block: 0;
  }

  .post :global(.wide)::-webkit-scrollbar {
    height: var(--spacing-300);
  }

  .post :global(.wide)::-webkit-scrollbar-track {
    background-color: var(--scrollbar-track-background);
    border: 1px solid var(--scrollbar-track-border);
  }

  .post :global(.wide)::-webkit-scrollbar-thumb {
    background-color: var(--scrollbar-thumb-background);
  }

  .post :global(p code),
  .post :global(li code) {
    background-color: var(--black);
    color: var(--nojaf-500);
    padding: 2px 6px;
    margin-inline: 2px;
    border-radius: var(--radius);
    font-family: var(--code-font);
    font-size: var(--font-400);
  }

  .post :global(pre.astro-code) {
    margin-block: var(--spacing-400);
    padding: var(--spacing-200) var(--spacing-300);
    border-radius: var(--radius);
    overflow-x: auto;
    font-family: var(--code-font);
    font-size: var(--font-300);
  }

  .post :global(pre.astro-code)::-webkit-scrollbar {
    height: var(--spacing-300);
  }

  .post :global(pre.astro-code)::-webkit-scrollbar-track {
    background-color: var(--scrollbar-track-background);
    border: 1px solid var(--scrollbar-track-border);
  }

  .post :global(pre.astro-code)::-webkit-scrollbar-thumb {
    background-color: var(--scrollbar-thumb-background);
  }

  .post :global(p:has(iframe)) {
    margin-block: var(--spacing-400);
  }

  .post :global(blockquote) {
    background-color: var(--nojaf-500);
    padding: var(--spacing-200);
    margin-block: var(--spacing-200);
  }

  .post :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Width alone, so the table keeps the reading column that .post > * hands
     every top-level block. A min-width here would break out of it: min-width
     beats max-width in the cascade, so a percentage one resolves against the
     full container and the table stops lining up with the prose beside it. */
  .post :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--spacing-400);
    font-size: var(--font-400);
  }

  .post :global(th),
  .post :global(td) {
    padding: var(--spacing-100) var(--spacing-300);
    text-align: left;
    border-bottom: 1px solid var(--rule);
  }

  /* Markdown centres nothing by default but the browser does centre <th>,
     which reads as a wonky second column against left-aligned cells. */
  .post :global(th) {
    font-weight: 700;
    border-bottom: 2px solid var(--black);
    white-space: nowrap;
  }

  .post :global(td) {
    font-weight: 300;
  }

  /* The first column is nearly always the label, and it wants the room. */
  .post :global(th:first-child),
  .post :global(td:first-child) {
    padding-left: 0;
  }

  .post :global(th:last-child),
  .post :global(td:last-child) {
    padding-right: 0;
  }

  .post :global(tbody tr:last-child td) {
    border-bottom: none;
  }
</style>
